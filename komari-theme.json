{
  "name": "Komari Retro Trio",
  "short": "RetroTrio",
  "description": "Three switchable skins in one theme: Retro Terminal / Cyberpunk / Pixel Game",
  "version": "1.0.2",
  "author": "ttvdKaori",
  "url": "https://github.com/ttvdKaori/komari-theme-retro-trio",
  "configuration": {
    "type": "managed",
    "name": { "zh-CN": "Retro Trio 设置", "en": "Retro Trio Settings" },
    "data": [
      { "name": { "zh-CN": "基础设置", "en": "General" }, "type": "title" },
      {
        "key": "default_style",
        "name": { "zh-CN": "默认皮肤", "en": "Default skin" },
        "type": "select",
        "options": "terminal,cyber,pixel",
        "default": "terminal",
        "help": { "zh-CN": "访客未手动选择皮肤时使用的默认风格", "en": "Used when a visitor has not picked a skin" }
      },
      {
        "key": "scanlines",
        "name": { "zh-CN": "CRT 扫描线", "en": "CRT scanlines" },
        "type": "switch",
        "default": true,
        "help": { "zh-CN": "复古终端皮肤的扫描线/辉光效果", "en": "Scanline & glow FX for the terminal skin" }
      },
      {
        "key": "glow",
        "name": { "zh-CN": "霓虹辉光", "en": "Neon glow" },
        "type": "switch",
        "default": true,
        "help": { "zh-CN": "赛博朋克皮肤的霓虹发光效果", "en": "Neon glow FX for the cyberpunk skin" }
      },
      {
        "key": "footer_text",
        "name": { "zh-CN": "页脚附加文字", "en": "Extra footer text" },
        "type": "richtext",
        "default": "",
        "help": { "zh-CN": "显示在页脚的自定义 HTML", "en": "Custom HTML shown in the footer" }
      }
    ]
  }
}
